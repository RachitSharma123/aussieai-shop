---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { faqs } from '../data/site';
import { breadcrumbSchema, canonicalPath, faqSchema } from '../data/seo';
const schemas = [
  breadcrumbSchema([
    ['Home', '/'],
    ['FAQ', '/faq'],
  ]),
  faqSchema(faqs),
];
---
<Base title="AI Automation FAQ Australia | Aussie AI" description="Straight answers about AI agents, AI receptionists, missed call text back, workflow automation, integrations and getting started." canonical={canonicalPath('/faq')}>
  <Fragment slot="head">
    {schemas.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
  </Fragment>
  <Nav />
  <main><section class="section page-hero"><div class="container narrow reveal"><p class="eyebrow">FAQ</p><h1>Common questions.</h1><p class="lead">Short, practical answers before we talk through your workflow.</p><div class="actions"><a class="btn primary" href="/contact">Book Free AI Audit</a></div></div></section>
  <section class="section"><div class="container faq-list reveal">{faqs.map(([q, a]) => <details class="faq-item"><summary>{q}</summary><p>{a}</p></details>)}</div></section></main>
  <Footer />
</Base>
