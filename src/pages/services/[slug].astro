---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { serviceLandingPages } from '../../data/landing-pages';
import { breadcrumbSchema, canonicalPath, faqSchema, serviceSchema } from '../../data/seo';

export function getStaticPaths() {
  return serviceLandingPages.map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

const { page } = Astro.props;
const schemas = [
  breadcrumbSchema([
    ['Home', '/'],
    ['Services', '/services'],
    [page.title, `/services/${page.slug}`],
  ]),
  serviceSchema({
    name: page.title,
    description: page.description,
    path: `/services/${page.slug}`,
    audience: page.audience,
  }),
  faqSchema(page.faqs),
];
---
<Base title={page.metaTitle} description={page.description} canonical={canonicalPath(`/services/${page.slug}`)}>
  <Fragment slot="head">
    {schemas.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
  </Fragment>
  <Nav />
  <main>
    <section class="section page-hero">
      <div class="container narrow reveal">
        <p class="eyebrow">{page.eyebrow}</p>
        <h1>{page.h1}</h1>
        <p class="lead">{page.intro}</p>
        <div class="actions">
          <a class="btn primary" href="/contact">Book Free AI Audit</a>
          <a class="btn secondary" href="/services">View All Services</a>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container detail-grid landing-summary">
        <article class="card reveal">
          <p class="eyebrow">Best for</p>
          <ul class="check-list">{page.bestFor.map((item) => <li>{item}</li>)}</ul>
        </article>
        <article class="card reveal">
          <p class="eyebrow">Can automate</p>
          <ul class="check-list">{page.automations.map((item) => <li>{item}</li>)}</ul>
        </article>
        <article class="card reveal">
          <p class="eyebrow">Start here</p>
          <h2>Map the workflow first.</h2>
          <p>We confirm the customer journey, staff handoff and tools before recommending what to build.</p>
          <a href="/contact">Discuss this service</a>
        </article>
      </div>
    </section>

    <section class="section">
      <div class="container bento three">
        {page.sections.map(([title, copy]) => <article class="card reveal"><h2>{title}</h2><p>{copy}</p></article>)}
      </div>
    </section>

    <section class="section">
      <div class="container section-head reveal">
        <p class="eyebrow">Common questions</p>
        <h2>Practical details before the audit.</h2>
      </div>
      <div class="container faq-list reveal">
        {page.faqs.map(([question, answer]) => <details class="faq-item"><summary>{question}</summary><p>{answer}</p></details>)}
      </div>
    </section>

    <section class="section">
      <div class="container section-head reveal">
        <p class="eyebrow">Related pages</p>
        <h2>Useful next reads.</h2>
      </div>
      <div class="container bento three">
        {page.related.map(([label, href]) => <article class="card reveal"><h3>{label}</h3><a href={href}>Open page</a></article>)}
      </div>
    </section>

    <section class="section final-cta">
      <div class="container narrow reveal">
        <h2>Want to know if this fits your workflow?</h2>
        <p>Book a free audit and Aussie AI will map the simplest useful automation for your business.</p>
        <a class="btn primary" href="/contact">Get Your Free Automation Blueprint</a>
      </div>
    </section>
  </main>
  <Footer />
</Base>
